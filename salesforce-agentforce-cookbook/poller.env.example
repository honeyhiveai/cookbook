# Required for a real export. Leave these out of a dry-run preview.
HH_API_KEY=
HH_API_URL=https://api.dp1.us.prod.honeyhive.ai

# My Domain login host that serves /services/oauth2/token.
# Use https://<domain>.my.salesforce.com, not Lightning or Experience Cloud.
SALESFORCE_INSTANCE_URL=https://mydomain.my.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# Optional. Defaults shown.
# SALESFORCE_API_VERSION=v66.0
# POLL_INTERVAL=60
# DISCOVERY_WINDOW_DAYS=4
# DISCOVERY_LIMIT=20
# SESSION_IDLE_SECONDS=120
# EXPORTED_FILE=.agentforce-exported.json

# Do not set these here. Pass them inline on a preview or pin command:
# SALESFORCE_SESSION_ID, HONEYHIVE_SESSION_ID, HONEYHIVE_SESSION_NAME,
# MAX_PASSES, DRY_RUN
