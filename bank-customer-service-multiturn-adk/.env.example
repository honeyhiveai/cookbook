# Copy this file to .env and fill in the two keys marked REQUIRED.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit it.


# ─── Gemini (REQUIRED) ────────────────────────────────────────────────────────
# Google AI Studio key: https://aistudio.google.com/apikey
# The agent will not run without this.
GOOGLE_API_KEY=

# Pinned deliberately. ADK's own default drifts between releases, and "-latest"
# aliases break on some regional endpoints.
GEMINI_MODEL=gemini-2.5-flash


# ─── HoneyHive (REQUIRED for tracing) ─────────────────────────────────────────
# Project-scoped API key: app.us.honeyhive.ai -> Settings -> API Keys
# The key alone determines which project traces land in; there is no project
# name to configure. Leave this blank and the demo still runs, but untraced.
HH_API_KEY=

# Labels the traces. Handy for separating demo runs from real traffic.
HH_SOURCE=demo

# Only for dedicated or self-hosted deployments.
# Default: https://api.dp1.us.honeyhive.ai
# HH_API_URL=

HH_VERBOSE=false


# ─── NOT set here: the Anthropic key ──────────────────────────────────────────
# The session-level LLM judge calls Claude, but it reads its key from HoneyHive,
# not from this file. Add it in the HoneyHive UI:
#
#     Settings -> Provider Secrets -> Anthropic
#
# Without it the two Python evaluators still work; the judge reports a failure
# on each session instead of a score.


# ─── ADK telemetry ────────────────────────────────────────────────────────────
# Required for the judge: without it, prompts and responses are elided from spans
# and the judge has no conversation to read.
#
# Note this ships full prompts, tool arguments and tool responses — including the
# synthetic customer PII — to the observability backend. That trade-off is worth
# naming out loud when demoing.
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=true

# Pin the span schema; ADK is mid-migration between versions and the span tree
# shape differs between them.
ADK_TELEMETRY_SCHEMA_VERSION_OPT_IN=1


# ─── Demo behaviour ───────────────────────────────────────────────────────────
# false = vulnerable. The tools have no authorization check, the attacks succeed,
#         and HoneyHive detects them. This is the default and the point.
# true  = guarded. A before_tool_callback blocks cross-customer calls, so the
#         attempts are still traced but nothing is disclosed.
GUARDRAIL_ENABLED=false
