# HoneyHive project API key (hh_...) for the project that holds the sessions.
# The provider reads sessions with the events search API, which takes a project key.
HH_PROJECT_API_KEY=your_honeyhive_api_key
# HoneyHive data plane URL. Change it for dedicated or self-hosted deployments.
HH_DATA_PLANE_URL=https://api.dp1.us.honeyhive.ai
# Key for the evaluators' judge model.
OPENAI_API_KEY=your_openai_api_key
