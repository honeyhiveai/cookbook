# HoneyHive project API key. Used for the OTLP export and for the experiments API.
HH_PROJECT_API_KEY=your_honeyhive_api_key
# HoneyHive data plane URL. Change it for dedicated or self-hosted deployments.
HH_DATA_PLANE_URL=https://api.dp1.us.prod.honeyhive.ai
# HoneyHive app URL for the printed run link.
HH_APP_URL=https://app.us.honeyhive.ai

# Model provider key for the agent and the LLM judge.
OPENAI_API_KEY=your_openai_api_key

# Optional: run against a HoneyHive dataset instead of the inline dataset.
# HH_DATASET_ID=
